# cp .env.example .env, then fill it in. `npm run deploy` reads it.

# Tempo ===========================================================================
# localnet for a local `anvil --network tempo` (its unlocked dev accounts sign),
# or any name for a live network
TEMPO_NETWORK=moderato
TEMPO_RPC_NETWORK_URL=https://rpc.moderato.tempo.xyz
# Pays fees in the account's fee token (pathUSD on Moderato, from the faucet)
TEMPO_PRIVATE_KEY=
# Succinct's SP1 v6.1.0 Groth16 verifier or gateway where one is deployed
# (Tempo mainnet: 0xb69f2584CBcFf99a58C4e7002E8b89Af54a6f4e2). Leave empty on
# Moderato to deploy sp1-contracts' v6.1.0 verifier with the bridge.
TEMPO_SP1_VERIFIER_ADDRESS=
